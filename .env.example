# Copy to .env and fill in. .env is git-ignored — never commit real credentials.

# Existing Postgres container: order-management-db (postgres:18.3), shared with OrderManagementSystem
POSTGRES_HOST=localhost          # use order-management-db when the API runs in Docker
POSTGRES_PORT=5432
POSTGRES_DB=drogueria_starling
POSTGRES_USER=drogueria_app
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://drogueria_app:change-me@localhost:5432/drogueria_starling
TEST_DATABASE_URL=postgresql+asyncpg://drogueria_app:change-me@localhost:5432/drogueria_starling_test

# External Docker network of the Postgres container (the api service joins it)
POSTGRES_DOCKER_NETWORK=database_default

# API
JWT_SECRET=generate-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
STORE_TIMEZONE=America/Guatemala
